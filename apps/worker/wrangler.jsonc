{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The template. On its own it is the local development and test config. A
  // real deployment's values (account, Worker name, hostnames, database and
  // bucket ids) live in the private site file and are joined with this at
  // deploy time by scripts/site-config.mjs (decision D-16).
  "name": "cfmail-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "placement": { "mode": "smart" },
  // An IMAP session is a single long-lived invocation (`connect`), so its CPU
  // budget must cover hours of FETCH/SEARCH, not one HTTP request. Billing is
  // still by CPU actually used; this only lifts the cap.
  "limits": { "cpu_ms": 300000 },
  "alias": {
    // mimetext only uses mime-types#contentType to validate attachment types;
    // the shim avoids bundling the ~134 KB mime-db table.
    "mime-types": "./src/shims/mime-types.ts",
    // better-auth statically imports a few ATTR_* constants from here even with
    // telemetry off; the shim drops the ~54 KB convention table.
    "@opentelemetry/semantic-conventions": "./src/shims/semantic-conventions.ts"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker. Assets served directly would skip
    // withSecurityHeaders (src/index.ts), leaving the app's pages without a CSP.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfmail-local",
      "database_id": "local",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "cfmail-local-blobs"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_HUB",
        "class_name": "UserHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserHub"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}

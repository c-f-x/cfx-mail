{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "@cfx-mail/shared": ["../../packages/shared/src/index.ts"],
      "@cfx-mail/shared/*": ["../../packages/shared/src/*"],
      "@cfx-mail/db": ["../../packages/db/src/index.ts"],
      "@cfx-mail/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vitest.config.ts",
    "../../packages/shared/src/**/*",
    "../../packages/db/src/**/*"
  ]
}

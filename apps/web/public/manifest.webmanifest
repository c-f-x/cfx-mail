{
  "name": "cfmail",
  "short_name": "cfmail",
  "description": "Self-hosted mail on Cloudflare",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/compose?mailto=%s"
    }
  ],
  "background_color": "#0a0a0a",
  "theme_color": "#086a72",
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    // apps/web depends on @cfx-mail/worker only for types (Hono RPC AppType,
    // imported straight from worker sources) — no build artifacts are needed,
    // and inheriting ^build would close a cycle with the worker's asset embed.
    "@cfx-mail/web#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    // The web app type-checks against the Worker's route types, so a change in
    // the Worker's sources must invalidate the web typecheck's cache. Depending
    // on the Worker's typecheck folds its inputs into this task's hash.
    "@cfx-mail/web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@cfx-mail/worker#build": {
      "dependsOn": ["^build", "@cfx-mail/web#build"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}

{
  "name": "cf-mail",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "deploy": "scripts/deploy.sh",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:bundles": "node scripts/budgets/check-bundles.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware && biome check .",
    "lint:fix": "oxlint --type-aware --fix && biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test && node --test \"scripts/**/*.test.mjs\"",
    "test:slow": "node --test \"scripts/**/*.slowtest.mjs\"",
    "db:generate": "pnpm --filter @cfmail/db generate",
    "db:migrate": "pnpm --filter @cfmail/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.7"
  }
}

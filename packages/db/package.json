{
  "name": "@cfx-mail/db",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "wrangler d1 migrations apply DB --config ../../apps/worker/wrangler.jsonc",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/worker/wrangler.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
